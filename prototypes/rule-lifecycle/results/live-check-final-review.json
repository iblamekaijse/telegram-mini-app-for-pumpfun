  "findings": [
    {
      "defect": "MarketSnapshots starts a new process with an immediate poll, losing the previous cooldown/backoff. The rehearsal restart could therefore request a public snapshot in less than 10 seconds.",
      "reproduction": "Existing successful lifecycle test strengthened with outbound request timestamps; fails on original c807e899 tree with market cooldown must survive restart.",
      "fixed": "The same local report checkpoints a conservative in-flight deadline and the authoritative nextPollAtMs after completion. Launch waits for it before starting the sole existing worker. 429 Retry-After is preserved. The post-restart observation interval begins after actual launch, excluding cooldown wait.",
      "newTestCasesAdded": 0
    }
  ],
  "guaranteesReviewed": {
    "stableIds": "Persisted report.id plus create/enable/close/outbox request IDs; resume validates the stored rule; confirmed sends retained.",
    "existingObjects": "Initial snapshot blockers, owner/bot fingerprint, protected historical hashes, beforeWorkers recheck and current-rule checks; no revoke/close of user objects.",
    "poller": "Same startPanel/runTelegram worker, SQLite exclusive ownership; previous worker stopped and awaited before child launch. External consumers cannot be ruled out; 409 stops the run.",
    "limits": "120s automatic wait, 180s owner wait, 10min per process; existing transport timeouts/backoff. Uncertain market request may postpone launch by 128s or longer Retry-After.",
    "shutdown": "Runtime close aborts polling, stops timers, waits for source/send/local persistence, then releases SQLite; CLI awaits child and forwards SIGINT/SIGTERM. Instruction binding wrapper is terminated and awaited before live:check.",
    "evidence": "Test mode explicit; saved Cloud source evidence is source-only. API acceptance, correlated owner update/processing, virtual calculation and unconfirmed human view remain separate."
