# Configure locally using npm run setup (hidden terminal input + getMe).
# Never commit .env or send the token in chat. Empty token disables Telegram.
TELEGRAM_BOT_TOKEN=
# DEMO_PORT=4173
# DEMO_DATA_DIR=/absolute/path/to/existing/data-directory

# Written by setup after getMe; a bot ID is not a token.
# TELEGRAM_BOT_ID=
# DEMO_ENV_FILE=/absolute/path/to/local.env (select it in the shell, not inside .env)
